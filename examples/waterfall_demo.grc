options:
  parameters:
    alias: ''
    author: Youssef Mahmoud
    catch_exceptions: 'True'
    comment: ''
    copyright: ''
    description: Minimal waterfall demo. Multi-tone complex source feeds the CyberEther
      waterfall sink; Superluminal computes the FFT internally.
    device: Auto
    gen_linking: dynamic
    generate_options: cyberether_gui
    generator_class_name: CyberetherStandaloneGuiGenerator
    generator_module: gnuradio.cyberether.workflows.cyberether_standalone_gui
    hier_block_src_path: '.:'
    id: waterfall_demo
    max_nouts: '0'
    output_language: python
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: CyberEther Waterfall Demo
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

