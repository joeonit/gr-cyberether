options:
  parameters:
    author: Youssef Mahmoud
    catch_exceptions: 'True'
    comment: ''
    copyright: ''
    description: Showcase of every gr-cyberether feature - all three sink types,
      complex and float inputs, a mosaic layout using row and column spanning,
      and live controls driving the flowgraph from inside the CyberEther window.
    device: Auto
    gen_linking: dynamic
    generate_options: cyberether_gui
    hier_block_src_path: '.:'
    id: everything_demo
    max_nouts: '0'
    output_language: python
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: gr-cyberether showcase
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '256000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: noise_amp
  id: cyberether_cyber_range
  parameters:
    comment: Watch the constellation clusters tighten and spread.
    gui_hint: '""'
    label: noise level
    start: '0.0'
    stop: '0.6'
    value: '0.08'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 12]
    rotation: 0
    state: enabled
- name: freq_offset
  id: cyberether_cyber_range
  parameters:
    comment: Slides the signal across the waterfall and spins the constellation.
    gui_hint: '""'
    label: frequency offset [Hz]
    start: -60e3
    stop: 60e3
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 12]
    rotation: 0
    state: enabled
- name: analog_random_source_x_0
  id: analog_random_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    max: '4'
    maxoutbuf: '0'
    min: '0'
    minoutbuf: '0'
    num_samps: '65536'
    repeat: 'True'
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 156]
    rotation: 0
    state: enabled
- name: digital_chunks_to_symbols_xx_0
  id: digital_chunks_to_symbols_xx
  parameters:
    affinity: ''
    alias: ''
    comment: Unit-energy QPSK.
    dimension: '1'
    in_type: byte
    maxoutbuf: '0'
    minoutbuf: '0'
    num_ports: '1'
    out_type: complex
    symbol_table: '[0.707+0.707j, -0.707+0.707j, -0.707-0.707j, 0.707-0.707j]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [224, 140]
    rotation: 0
    state: enabled
- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [448, 156]
    rotation: 0
    state: enabled
- name: analog_sig_source_x_0
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1'
    comment: Slider-driven frequency shift.
    freq: freq_offset
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [448, 268]
    rotation: 0
    state: enabled
- name: blocks_multiply_xx_0
  id: blocks_multiply_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [656, 172]
    rotation: 0
    state: enabled
- name: analog_noise_source_x_0
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: noise_amp
    comment: Slider-driven noise.
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_type: analog.GR_GAUSSIAN
    seed: '42'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [656, 300]
    rotation: 0
    state: enabled
- name: blocks_add_xx_0
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [856, 204]
    rotation: 0
    state: enabled
- name: blocks_complex_to_mag_0
  id: blocks_complex_to_mag
  parameters:
    affinity: ''
    alias: ''
    comment: Feeds the float sink.
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 420]
    rotation: 0
    state: enabled
- name: cyberether_cyber_constellation_sink_0
  id: cyberether_cyber_constellation_sink
  parameters:
    affinity: ''
    alias: ''
    buffer_size: '2048'
    comment: Spans the full left column.
    gui_hint: '"0, 0, 2, 1"'
    name: '"constellation"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 76]
    rotation: 0
    state: enabled
- name: cyberether_cyber_lineplot_sink_0
  id: cyberether_cyber_lineplot_sink
  parameters:
    affinity: ''
    alias: ''
    buffer_size: '4096'
    comment: ''
    display: Time
    gui_hint: '"0, 1"'
    name: '"scope"'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 156]
    rotation: 0
    state: enabled
- name: cyberether_cyber_lineplot_sink_1
  id: cyberether_cyber_lineplot_sink
  parameters:
    affinity: ''
    alias: ''
    buffer_size: '4096'
    comment: ''
    display: Frequency
    gui_hint: '"0, 2"'
    name: '"spectrum"'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 236]
    rotation: 0
    state: enabled
- name: cyberether_cyber_waterfall_sink_0
  id: cyberether_cyber_waterfall_sink
  parameters:
    affinity: ''
    alias: ''
    comment: Spans two columns.
    display: Frequency
    fft_size: '1024'
    gui_hint: '"1, 1, 1, 2"'
    height: '256'
    name: '"waterfall"'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 316]
    rotation: 0
    state: enabled
- name: cyberether_cyber_lineplot_sink_2
  id: cyberether_cyber_lineplot_sink
  parameters:
    affinity: ''
    alias: ''
    buffer_size: '4096'
    comment: Float input, spans the whole bottom row.
    display: Time
    gui_hint: '"2, 0, 1, 3"'
    name: '"magnitude"'
    type: float
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1240, 420]
    rotation: 0
    state: enabled

connections:
- [analog_random_source_x_0, '0', digital_chunks_to_symbols_xx_0, '0']
- [digital_chunks_to_symbols_xx_0, '0', blocks_throttle2_0, '0']
- [blocks_throttle2_0, '0', blocks_multiply_xx_0, '0']
- [analog_sig_source_x_0, '0', blocks_multiply_xx_0, '1']
- [blocks_multiply_xx_0, '0', blocks_add_xx_0, '0']
- [analog_noise_source_x_0, '0', blocks_add_xx_0, '1']
- [blocks_add_xx_0, '0', cyberether_cyber_constellation_sink_0, '0']
- [blocks_add_xx_0, '0', cyberether_cyber_lineplot_sink_0, '0']
- [blocks_add_xx_0, '0', cyberether_cyber_lineplot_sink_1, '0']
- [blocks_add_xx_0, '0', cyberether_cyber_waterfall_sink_0, '0']
- [blocks_add_xx_0, '0', blocks_complex_to_mag_0, '0']
- [blocks_complex_to_mag_0, '0', cyberether_cyber_lineplot_sink_2, '0']

metadata:
  file_format: 1
  grc_version: 3.11.0.0git
